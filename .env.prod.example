# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — Plantilla para producción
#
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.prod.example .env.prod
# 2. Rellena TODOS los valores (no dejes ninguno vacío)
# 3. Copia el contenido COMPLETO de .env.prod
# 4. En GitHub → Settings → Secrets → Actions → New repository secret:
#       Nombre: PROD_ENV_FILE
#       Valor:  pega aquí el contenido completo de .env.prod
#
# NUNCA hagas commit de .env.prod — ya está cubierto por **/.env en .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── Auth Service ─────────────────────────────────────────────────────────────
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_USER=authuser
AUTH_DB_PASS=cambia-este-password-seguro-auth

# ─── Reservation Service ──────────────────────────────────────────────────────
RESERVATION_DB_HOST=reservation-db
RESERVATION_DB_PORT=5432
RESERVATION_DB_USER=reservationuser
RESERVATION_DB_PASS=cambia-este-password-seguro-reservation

# ─── Laboratory Service ───────────────────────────────────────────────────────
LAB_DB_HOST=laboratory-db
LAB_DB_PORT=5432
LAB_DB_USER=labuser
LAB_DB_PASS=cambia-este-password-seguro-lab

# ─── Notification Service ─────────────────────────────────────────────────────
NOTIF_DB_HOST=notification-db
NOTIF_DB_PORT=5432
NOTIF_DB_USER=notifuser
NOTIF_DB_PASS=cambia-este-password-seguro-notif

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=cambia-este-jwt-secret-minimo-64-caracteres-aleatorios-aqui

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# Usuario y password del contenedor RabbitMQ.
# La URL debe coincidir con RABBITMQ_USER y RABBITMQ_PASS.
RABBITMQ_USER=prodrabbit
RABBITMQ_PASS=cambia-este-password-seguro-rabbitmq
RABBITMQ_URL=amqp://prodrabbit:cambia-este-password-seguro-rabbitmq@rabbitmq:5672

# ─── SMTP (Gmail App Password) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
# En producción usa el DNS del ALB. Temporalmente puedes usar *
CORS_ORIGIN=*